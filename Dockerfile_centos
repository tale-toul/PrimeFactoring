#Image for the network factoring clients (python3 FactorClient.py ...), based on Red Hat UBI 9
#with python 3.12.  It no longer uses CentOS or EPEL, the file name is kept for compatibility
#The base image already runs as a non root user (UID 1001) inside a python virtual environment
FROM registry.access.redhat.com/ubi9/python-312
LABEL maintainer="Tale <tale.toul@gmail.com>"
#Twisted is required; gmpy2 is optional
RUN pip install --no-cache-dir Twisted gmpy2
ENV APH=/opt/app-root/src/FactorC
COPY *.py $APH/
WORKDIR $APH
ENTRYPOINT ["python3"]
